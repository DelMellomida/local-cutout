{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "local-cutout",
  "main": "./src/edge-worker.ts",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/model-files/*"],
  },
}
